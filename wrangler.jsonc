{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chemcards",
  "main": "dist/server/index.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chemcards-db",
      "database_id": "chemcards-db"
    }
  ]
}
